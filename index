function formatDate(date){

  return new Date(date)
    .toLocaleDateString("en-GB",{
      day:"2-digit",
      month:"short",
      year:"numeric"
    });

}


function renderWorkLogs(){

  const table =
    document.getElementById("workLogTable");

  const dashboard =
    document.getElementById("dashboardWorkLogs");

  const search =
    (
      document.getElementById("workSearch")
      ?.value
      || ""
    )
    .toLowerCase();

  const filter =
    document.getElementById("workFilter")
    ?.value
    || "all";


  let filtered =
    workLogs.filter(log => {

      const matchesSearch =
        log.task.toLowerCase().includes(search)
        ||
        log.description.toLowerCase().includes(search);

      const matchesFilter =
        filter === "all"
        ||
        log.category === filter;

      return matchesSearch && matchesFilter;

    });


  filtered.sort(
    (a,b) =>
      new Date(b.date)
      -
      new Date(a.date)
  );


  table.innerHTML = "";


  if(filtered.length === 0){

    table.innerHTML = `
      <tr>
        <td colspan="5">
          <div class="empty">
            No work logs found.
          </div>
        </td>
      </tr>
    `;

  }else{

    filtered.forEach(log => {

      table.innerHTML += `

        <tr>

          <td>
            ${formatDate(log.date)}
          </td>

          <td>
            <strong>${escapeHTML(log.task)}</strong>
          </td>

          <td>
            <span class="badge neutral">
              ${escapeHTML(log.category)}
            </span>
          </td>

          <td>
            ${escapeHTML(log.description)}
          </td>

          <td>
            <span class="badge success">
              Completed
            </span>
          </td>

        </tr>

      `;

    });

  }


  document
    .getElementById("workLogCount")
    .textContent = workLogs.length;


  dashboard.innerHTML = "";


  workLogs
    .slice()
    .sort(
      (a,b) =>
        new Date(b.date)
        -
        new Date(a.date)
    )
    .slice(0,4)
    .forEach(log => {

      dashboard.innerHTML += `

        <div class="notification-item">

          <div class="notification-circle">
            ✓
          </div>

          <div>

            <strong>
              ${escapeHTML(log.task)}
            </strong>

            <p>
              ${escapeHTML(log.description)}
            </p>

            <small>
              ${formatDate(log.date)}
            </small>

          </div>

        </div>

      `;

    });

}


document
.getElementById("workSearch")
.addEventListener(
  "input",
  renderWorkLogs
);


document
.getElementById("workFilter")
.addEventListener(
  "change",
  renderWorkLogs
);


