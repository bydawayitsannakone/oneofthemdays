<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nona Costex Staff Portal</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f6f5f2;
            color: #292929;
        }

        button,
        input {
            font-family: inherit;
        }

        /* =========================
           LOGIN
        ========================= */

        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: #f3f1ed;
        }

        .login-box {
            width: 100%;
            max-width: 420px;
            background: #ffffff;
            padding: 45px 40px;
            border-radius: 18px;
            box-shadow: 0 10px 35px rgba(0,0,0,0.06);
        }

        .logo {
            width: 48px;
            height: 48px;
            background: #292929;
            color: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-bottom: 25px;
        }

        .login-box h1 {
            font-size: 26px;
            margin-bottom: 8px;
        }

        .login-box p {
            color: #888;
            font-size: 14px;
            margin-bottom: 30px;
        }

        .input-group {
            margin-bottom: 18px;
        }

        .input-group label {
            display: block;
            font-size: 13px;
            margin-bottom: 7px;
            color: #555;
        }

        .input-group input {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid #ddd;
            border-radius: 10px;
            outline: none;
            background: #fafafa;
        }

        .input-group input:focus {
            border-color: #888;
            background: white;
        }

        .login-btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #292929;
            color: white;
            cursor: pointer;
            font-size: 14px;
            margin-top: 5px;
        }

        .login-btn:hover {
            background: #444;
        }

        .login-note {
            text-align: center;
            margin-top: 20px;
            font-size: 12px;
            color: #aaa;
        }


        /* =========================
           APP
        ========================= */

        .app {
            display: none;
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 245px;
            height: 100vh;
            background: #ffffff;
            border-right: 1px solid #e9e7e2;
            padding: 28px 18px;
            display: flex;
            flex-direction: column;
        }

        .brand {
            padding: 0 12px;
            margin-bottom: 40px;
        }

        .brand-name {
            font-size: 17px;
            font-weight: bold;
        }

        .brand-subtitle {
            font-size: 11px;
            color: #999;
            margin-top: 4px;
        }

        .nav-title {
            font-size: 10px;
            text-transform: uppercase;
            color: #aaa;
            padding: 0 12px;
            margin-bottom: 10px;
            letter-spacing: 1px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 12px;
            border-radius: 9px;
            border: none;
            background: transparent;
            color: #777;
            cursor: pointer;
            text-align: left;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .nav-item:hover {
            background: #f5f4f1;
            color: #292929;
        }

        .nav-item.active {
            background: #292929;
            color: white;
        }

        .nav-icon {
            width: 18px;
            text-align: center;
        }

        .sidebar-bottom {
            margin-top: auto;
        }

        .logout-btn {
            width: 100%;
            padding: 12px;
            border: none;
            background: transparent;
            color: #888;
            cursor: pointer;
            text-align: left;
            border-radius: 9px;
            font-size: 13px;
        }

        .logout-btn:hover {
            background: #f5f4f1;
            color: #292929;
        }


        /* =========================
           MAIN CONTENT
        ========================= */

        .main {
            margin-left: 245px;
            padding: 35px 40px;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 35px;
        }

        .page-title h2 {
            font-size: 25px;
            margin-bottom: 5px;
        }

        .page-title p {
            font-size: 13px;
            color: #999;
        }

        .user-mini {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #dedbd4;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: bold;
        }

        .user-info strong {
            font-size: 13px;
            display: block;
        }

        .user-info span {
            font-size: 11px;
            color: #999;
        }


        /* =========================
           DASHBOARD CARDS
        ========================= */

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: white;
            border: 1px solid #ebe9e4;
            border-radius: 14px;
            padding: 22px;
        }

        .stat-label {
            font-size: 12px;
            color: #999;
            margin-bottom: 14px;
        }

        .stat-number {
            font-size: 28px;
            font-weight: bold;
        }

        .stat-small {
            font-size: 11px;
            color: #999;
            margin-top: 7px;
        }


        /* =========================
           CONTENT GRID
        ========================= */

        .content-grid {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 20px;
        }

        .card {
            background: white;
            border: 1px solid #ebe9e4;
            border-radius: 14px;
            padding: 24px;
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .card-header h3 {
            font-size: 16px;
        }

        .card-header span {
            font-size: 11px;
            color: #999;
        }


        /* =========================
           SCHEDULE
        ========================= */

        .schedule-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 0;
            border-bottom: 1px solid #f0eee9;
        }

        .schedule-item:last-child {
            border-bottom: none;
        }

        .schedule-date {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            background: #f4f2ed;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .schedule-date strong {
            font-size: 15px;
        }

        .schedule-date span {
            font-size: 9px;
            color: #999;
        }

        .schedule-info {
            flex: 1;
            margin-left: 14px;
        }

        .schedule-info strong {
            display: block;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .schedule-info span {
            font-size: 11px;
            color: #999;
        }

        .schedule-status {
            font-size: 10px;
            padding: 6px 9px;
            border-radius: 20px;
            background: #f1f0ec;
            color: #666;
        }


        /* =========================
           WORK LOG
        ========================= */

        .work-log {
            display: flex;
            gap: 14px;
            padding: 13px 0;
            border-bottom: 1px solid #f0eee9;
        }

        .work-log:last-child {
            border-bottom: none;
        }

        .work-dot {
            width: 8px;
            height: 8px;
            background: #555;
            border-radius: 50%;
            margin-top: 5px;
        }

        .work-log strong {
            display: block;
            font-size: 12px;
            margin-bottom: 4px;
        }

        .work-log span {
            font-size: 11px;
            color: #999;
        }


        /* =========================
           PAGE SECTIONS
        ========================= */

        .page-section {
            display: none;
        }

        .page-section.active {
            display: block;
        }

        .section-card {
            background: white;
            border: 1px solid #ebe9e4;
            border-radius: 14px;
            padding: 25px;
            margin-bottom: 20px;
        }

        .section-card h3 {
            font-size: 17px;
            margin-bottom: 6px;
        }

        .section-card > p {
            color: #999;
            font-size: 12px;
            margin-bottom: 22px;
        }


        /* =========================
           PROFILE
        ========================= */

        .profile-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .profile-avatar {
            width: 75px;
            height: 75px;
            background: #dedbd4;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: bold;
        }

        .profile-name h3 {
            font-size: 20px;
            margin-bottom: 5px;
        }

        .profile-name span {
            color: #999;
            font-size: 12px;
        }

        .profile-details {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .detail {
            background: #f8f7f4;
            padding: 16px;
            border-radius: 10px;
        }

        .detail label {
            display: block;
            font-size: 10px;
            color: #999;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .detail span {
            font-size: 13px;
        }


        /* =========================
           TABLE
        ========================= */

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            font-size: 11px;
            color: #999;
            font-weight: normal;
            padding: 12px;
            border-bottom: 1px solid #eee;
        }

        td {
            padding: 14px 12px;
            font-size: 12px;
            border-bottom: 1px solid #f1f0ec;
        }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            background: #f2f1ed;
            color: #666;
            font-size: 10px;
        }


        /* =========================
           MOBILE
        ========================= */

        .mobile-menu {
            display: none;
        }

        @media (max-width: 900px) {

            .sidebar {
                width: 210px;
            }

            .main {
                margin-left: 210px;
                padding: 25px;
            }

            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 650px) {

            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 20px;
            }

            .mobile-menu {
                display: block;
                margin-bottom: 20px;
            }

            .mobile-menu button {
                border: none;
                background: white;
                padding: 10px 13px;
                border-radius: 9px;
                cursor: pointer;
            }

            .topbar {
                align-items: flex-start;
            }

            .user-info {
                display: none;
            }

            .stats {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .stat-card {
                padding: 16px;
            }

            .stat-number {
                font-size: 22px;
            }

            .profile-details {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>


<!-- =========================
     LOGIN PAGE
========================= -->

<div class="login-page" id="loginPage">

    <div class="login-box">

        <div class="logo">
            NC
        </div>

        <h1>Welcome back</h1>

        <p>Sign in to Nona Costex Staff Portal</p>

        <div class="input-group">
            <label>Staff Name / Username</label>
            <input
                type="text"
                id="username"
                placeholder="Enter your name"
            >
        </div>

        <div class="input-group">
            <label>Staff Code</label>
            <input
                type="password"
                id="staffCode"
                placeholder="Enter staff code"
            >
        </div>

        <button class="login-btn" onclick="login()">
            Sign In
        </button>

        <div class="login-note">
            Nona Costex Internal Staff Portal
        </div>

    </div>

</div>


<!-- =========================
     MAIN APP
========================= -->

<div class="app" id="app">


    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="brand">
            <div class="brand-name">
                Nona Costex
            </div>

            <div class="brand-subtitle">
                Staff Portal
            </div>
        </div>


        <div class="nav-title">
            Main Menu
        </div>

        <button class="nav-item active" onclick="showPage('dashboard', this)">
            <span class="nav-icon">⌂</span>
            Dashboard
        </button>

        <button class="nav-item" onclick="showPage('schedule', this)">
            <span class="nav-icon">□</span>
            My Schedule
        </button>

        <button class="nav-item" onclick="showPage('worklog', this)">
            <span class="nav-icon">☰</span>
            Daily Work Log
        </button>

        <button class="nav-item" onclick="showPage('attendance', this)">
            <span class="nav-icon">✓</span>
            Attendance
        </button>

        <button class="nav-item" onclick="showPage('leave', this)">
            <span class="nav-icon">○</span>
            Leave
        </button>


        <div class="nav-title" style="margin-top:25px;">
            Account
        </div>

        <button class="nav-item" onclick="showPage('profile', this)">
            <span class="nav-icon">◯</span>
            My Profile
        </button>


        <div class="sidebar-bottom">

            <button class="logout-btn" onclick="logout()">
                ↪ &nbsp; Log out
            </button>

        </div>

    </aside>


    <!-- MAIN -->

    <main class="main">

        <div class="mobile-menu">
            <button onclick="alert('Mobile menu can be added later')">
                ☰ Menu
            </button>
        </div>


        <!-- =========================
             DASHBOARD
        ========================== -->

        <section class="page-section active" id="dashboard">

            <div class="topbar">

                <div class="page-title">
                    <h2>Good morning, <span id="displayName">Atikah</span></h2>
                    <p>Here's your work overview for today.</p>
                </div>

                <div class="user-mini">

                    <div class="avatar">
                        AN
                    </div>

                    <div class="user-info">
                        <strong id="topName">Atikah</strong>
                        <span>Digital Team</span>
                    </div>

                </div>

            </div>


            <div class="stats">

                <div class="stat-card">

                    <div class="stat-label">
