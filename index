/* =========================
   LEAVE
========================= */

document
.getElementById("applyLeaveBtn")
.addEventListener("click", function(){

  document
    .getElementById("leaveModal")
    .classList.add("show");

});


document
.querySelectorAll('[data-action="leave"]')
.forEach(button => {

  button.addEventListener("click", function(){

    document
      .getElementById("leaveModal")
      .classList.add("show");

  });

});


document
.getElementById("leaveForm")
.addEventListener("submit", function(e){

  e.preventDefault();


  const start =
    document.getElementById("leaveStart").value;

  const end =
    document.getElementById("leaveEnd").value;


  if(new Date(end) < new Date(start)){

    alert(
      "End date cannot be earlier than start date."
    );

    return;

  }


  const days =
    Math.floor(
      (
        new Date(end)
        -
        new Date(start)
      )
      /
      (1000 * 60 * 60 * 24)
    )
    + 1;


  leaves.push({

    type:
      document.getElementById("leaveType").value,

    start,
    end,

    days,

    reason:
      document.getElementById("leaveReason").value,

    status:"Pending"

  });


  localStorage.setItem(
    "nonaLeaves",
    JSON.stringify(leaves)
  );


  renderLeaves();

  this.reset();

  closeModal("leaveModal");

  alert(
    "Leave application submitted successfully."
  );

});


function renderLeaves(){

  const table =
    document.getElementById("leaveTable");

  if(leaves.length === 0){

    return;

  }


  table.innerHTML = "";


  leaves.forEach(leave => {

    table.innerHTML += `

      <tr>

        <td>${escapeHTML(leave.type)}</td>

        <td>${formatDate(leave.start)}</td>

        <td>${formatDate(leave.end)}</td>

        <td>${leave.days}</td>

        <td>${escapeHTML(leave.reason)}</td>

        <td>
          <span class="badge warning">
            Pending
          </span>
        </td>

      </tr>

    `;

  });

}


renderLeaves();


