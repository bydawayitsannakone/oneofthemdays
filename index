========================= */

function updateClock(){

  const now = new Date();

  document
    .getElementById("liveClock")
    .textContent =
      now.toLocaleTimeString("en-MY",{
        hour12:false
      });

  document
    .getElementById("liveDate")
    .textContent =
      now.toLocaleDateString("en-MY",{
        weekday:"long",
        day:"numeric",
        month:"long",
        year:"numeric"
      });

}


setInterval(updateClock,1000);

updateClock();


/* =========================
   ATTENDANCE
========================= */

function currentTime(){

  return new Date()
    .toLocaleTimeString("en-MY",{
      hour:"2-digit",
      minute:"2-digit"
    });

}


function updateAttendance(){

  const status =
    document.getElementById("attendanceStatus");

  const checkIn =
    document.getElementById("checkInTime");

  const checkOut =
    document.getElementById("checkOutTime");

  const workingStatus =
    document.getElementById("workingStatus");

  const checkInBtn =
    document.getElementById("checkInBtn");

  const checkOutBtn =
    document.getElementById("checkOutBtn");


  checkIn.textContent =
    attendance.checkIn || "--:--";

  checkOut.textContent =
    attendance.checkOut || "--:--";


  if(!attendance.checkIn){

    status.textContent =
      "Not Checked In";

    workingStatus.textContent =
      "Not Started";

    checkInBtn.disabled = false;
    checkOutBtn.disabled = true;

  }else if(
    attendance.checkIn
    &&
    !attendance.checkOut
  ){

    status.textContent =
      "Working";

    workingStatus.textContent =
      "Currently Working";

    checkInBtn.disabled = true;
    checkOutBtn.disabled = false;

  }else{

    status.textContent =
      "Completed";

    workingStatus.textContent =
      "Day Completed";

    checkInBtn.disabled = true;
    checkOutBtn.disabled = true;

  }

}


document
.getElementById("checkInBtn")
.addEventListener("click", function(){

  if(attendance.checkIn){
    return;
  }

  attendance.checkIn =
    currentTime();

  localStorage.setItem(
    "nonaAttendance",
    JSON.stringify(attendance)
  );

  updateAttendance();

  alert(
    "Check-in recorded at " +
    attendance.checkIn
  );

});


document
.getElementById("checkOutBtn")
.addEventListener("click", function(){

  if(
    !attendance.checkIn
    ||
    attendance.checkOut
  ){
    return;
  }

  attendance.checkOut =
    currentTime();

  localStorage.setItem(
    "nonaAttendance",
    JSON.stringify(attendance)
  );

  updateAttendance();

  alert(
    "Check-out recorded at " +
    attendance.checkOut
  );

});


