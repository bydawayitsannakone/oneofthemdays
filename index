<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nona Costex Staff Portal</title>

<style>
:root{
  --bg:#f5f3ef;
  --card:#ffffff;
  --sidebar:#20231f;
  --sidebar-text:#d9ddd5;
  --sidebar-active:#343a32;
  --text:#242722;
  --muted:#7a7f76;
  --border:#e6e4de;
  --accent:#68745e;
  --accent-light:#edf0ea;
  --success:#55745b;
  --success-bg:#edf5ee;
  --warning:#9a7842;
  --warning-bg:#fbf4e7;
  --danger:#9a5c5c;
  --danger-bg:#faeeee;
  --shadow:0 8px 30px rgba(35,38,31,.06);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial, Helvetica, sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,
input,
select,
textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

.hidden{
  display:none !important;
}

/* LOGIN */

.login-page{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:24px;
  background:#f3f1ec;
}

.login-box{
  width:100%;
  max-width:420px;
  background:white;
  border:1px solid var(--border);
  border-radius:20px;
  padding:42px;
  box-shadow:var(--shadow);
}

.logo{
  width:52px;
  height:52px;
  background:var(--sidebar);
  color:white;
  border-radius:14px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:bold;
  font-size:18px;
  margin-bottom:22px;
}

.login-box h1{
  font-size:26px;
  margin-bottom:8px;
}

.login-subtitle{
  color:var(--muted);
  font-size:14px;
  margin-bottom:30px;
}

.form-group{
  margin-bottom:18px;
}

.form-group label{
  display:block;
  font-size:13px;
  font-weight:600;
  margin-bottom:8px;
}

input,
select,
textarea{
  width:100%;
  border:1px solid var(--border);
  background:#fff;
  border-radius:10px;
  padding:12px 13px;
  outline:none;
  color:var(--text);
}

input:focus,
select:focus,
textarea:focus{
  border-color:var(--accent);
}

textarea{
  min-height:100px;
  resize:vertical;
}

.primary-btn{
  width:100%;
  border:none;
  background:var(--sidebar);
  color:white;
  padding:13px;
  border-radius:10px;
  font-weight:600;
  transition:.2s;
}

.primary-btn:hover{
  background:#343932;
}

.login-note{
  margin-top:18px;
  padding:12px;
  background:var(--accent-light);
  border-radius:10px;
  color:#5e6659;
  font-size:12px;
  line-height:1.5;
}

/* APP */

.app{
  min-height:100vh;
  display:flex;
}

.sidebar{
  width:245px;
  min-height:100vh;
  background:var(--sidebar);
  color:white;
  position:fixed;
  left:0;
  top:0;
  bottom:0;
  padding:24px 16px;
  z-index:20;
}

.brand{
  padding:4px 12px 28px;
  border-bottom:1px solid rgba(255,255,255,.08);
  margin-bottom:20px;
}

.brand-title{
  font-size:17px;
  font-weight:700;
}

.brand-sub{
  color:#9ca398;
  font-size:11px;
  margin-top:5px;
}

.nav-title{
  color:#7f877b;
  text-transform:uppercase;
  font-size:10px;
  letter-spacing:1px;
  padding:0 12px;
  margin:20px 0 8px;
}

.nav-item{
  display:flex;
  align-items:center;
  gap:12px;
  width:100%;
  border:none;
  background:transparent;
  color:var(--sidebar-text);
  padding:11px 12px;
  border-radius:9px;
  margin-bottom:3px;
  text-align:left;
  font-size:13px;
}

.nav-item:hover{
  background:rgba(255,255,255,.06);
}

.nav-item.active{
  background:var(--sidebar-active);
  color:white;
}

.nav-icon{
  width:20px;
  text-align:center;
  font-size:15px;
}

.sidebar-bottom{
  position:absolute;
  left:16px;
  right:16px;
  bottom:20px;
}

.logout-btn{
  color:#d6a2a2;
}

/* MAIN */

.main{
  margin-left:245px;
  width:calc(100% - 245px);
  min-height:100vh;
}

.topbar{
  height:72px;
  background:white;
  border-bottom:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 32px;
  position:sticky;
  top:0;
  z-index:10;
}

.page-title{
  font-size:18px;
  font-weight:700;
}

.topbar-right{
  display:flex;
  align-items:center;
  gap:18px;
}

.notification{
  position:relative;
  border:none;
  background:transparent;
  font-size:19px;
}

.notification-dot{
  position:absolute;
  top:-1px;
  right:-2px;
  width:7px;
  height:7px;
  border-radius:50%;
  background:#a55b5b;
}

.user-mini{
  display:flex;
  align-items:center;
  gap:10px;
}

.avatar{
  width:36px;
  height:36px;
  border-radius:50%;
  background:#d9ddd4;
  color:#50574b;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:700;
  font-size:13px;
}

.user-mini-info small{
  color:var(--muted);
  display:block;
  font-size:10px;
}

.user-mini-info span{
  font-size:12px;
  font-weight:600;
}

.content{
  padding:30px 32px;
  max-width:1500px;
  margin:auto;
}

/* DASHBOARD */

.welcome{
  margin-bottom:26px;
}

.welcome h2{
  font-size:25px;
  margin-bottom:6px;
}

.welcome p{
  color:var(--muted);
  font-size:13px;
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
  margin-bottom:25px;
}

.stat-card{
  background:white;
  border:1px solid var(--border);
  border-radius:14px;
  padding:20px;
}

.stat-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:16px;
}

.stat-label{
  color:var(--muted);
  font-size:12px;
}

.stat-icon{
  width:34px;
  height:34px;
  border-radius:9px;
  background:var(--accent-light);
  display:flex;
  align-items:center;
  justify-content:center;
}

.stat-value{
  font-size:25px;
  font-weight:700;
}

.stat-desc{
  font-size:11px;
  color:var(--muted);
  margin-top:5px;
}

.dashboard-grid{
  display:grid;
  grid-template-columns:1.5fr 1fr;
  gap:20px;
}

.card{
  background:white;
  border:1px solid var(--border);
  border-radius:14px;
  padding:20px;
  margin-bottom:20px;
}

.card-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:18px;
}

.card-title{
  font-size:15px;
  font-weight:700;
}

.card-link{
  border:none;
  background:none;
  color:var(--accent);
  font-size:12px;
  cursor:pointer;
}

/* TABLE */

.table-wrapper{
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
}

th{
  text-align:left;
  color:var(--muted);
  font-size:11px;
  font-weight:600;
  padding:11px 10px;
  border-bottom:1px solid var(--border);
}

td{
  padding:13px 10px;
  border-bottom:1px solid #efeee9;
  font-size:12px;
}

tr:last-child td{
  border-bottom:none;
}

.badge{
  display:inline-flex;
  padding:5px 9px;
  border-radius:20px;
  font-size:10px;
  font-weight:600;
}

.badge.success{
  background:var(--success-bg);
  color:var(--success);
}

.badge.warning{
  background:var(--warning-bg);
  color:var(--warning);
}

.badge.danger{
  background:var(--danger-bg);
  color:var(--danger);
}

.badge.neutral{
  background:#f0f0ed;
  color:#666b63;
}

/* QUICK ACTION */

.quick-actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.quick-btn{
  border:1px solid var(--border);
  background:white;
  padding:14px;
  border-radius:10px;
  text-align:left;
  font-size:12px;
}

.quick-btn:hover{
  background:#fafaf8;
}

.quick-btn span{
  display:block;
  font-size:18px;
  margin-bottom:8px;
}

.quick-btn small{
  color:var(--muted);
}

/* PAGE */

.page{
  display:none;
}

.page.active{
  display:block;
}

.section-header{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  margin-bottom:22px;
}

.section-header h2{
  font-size:22px;
  margin-bottom:5px;
}

.section-header p{
  color:var(--muted);
  font-size:12px;
}

.action-btn{
  background:var(--sidebar);
  color:white;
  border:none;
  padding:11px 16px;
  border-radius:9px;
  font-size:12px;
  font-weight:600;
}

.secondary-btn{
  background:white;
  color:var(--text);
  border:1px solid var(--border);
  padding:10px 15px;
  border-radius:9px;
  font-size:12px;
}

/* FILTER */

.filters{
  display:flex;
  gap:10px;
  margin-bottom:18px;
  flex-wrap:wrap;
}

.search-box{
  max-width:280px;
}

/* ATTENDANCE */

.attendance-box{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
}

.attendance-main{
  text-align:center;
  padding:35px 20px;
}

.clock{
  font-size:40px;
  font-weight:700;
  letter-spacing:1px;
  margin:15px 0 5px;
}

.date-display{
  color:var(--muted);
  font-size:12px;
  margin-bottom:28px;
}

.attendance-actions{
  display:flex;
  justify-content:center;
  gap:10px;
}

.attendance-actions button{
  width:130px;
}

.time-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.time-box{
  padding:16px;
  background:#fafaf8;
  border-radius:10px;
}

.time-box small{
  display:block;
  color:var(--muted);
  font-size:10px;
  margin-bottom:7px;
}

.time-box strong{
  font-size:18px;
}

/* PROFILE */

.profile-grid{
  display:grid;
  grid-template-columns:300px 1fr;
  gap:20px;
}

.profile-card{
  text-align:center;
}

.profile-avatar{
  width:90px;
  height:90px;
  background:#d9ddd4;
  border-radius:50%;
  margin:10px auto 16px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:28px;
  font-weight:700;
  color:#50574b;
}

.profile-card h3{
  font-size:17px;
  margin-bottom:5px;
}

.profile-card p{
  color:var(--muted);
  font-size:11px;
}

.profile-status{
  margin:18px 0;
}

.info-list{
  text-align:left;
  border-top:1px solid var(--border);
  margin-top:20px;
  padding-top:8px;
}

.info-item{
  display:flex;
  justify-content:space-between;
  padding:11px 0;
  border-bottom:1px solid #efeee9;
  font-size:11px;
}

.info-item span:first-child{
  color:var(--muted);
}

/* MODAL */

.modal-overlay{
  position:fixed;
  inset:0;
  background:rgba(20,23,19,.45);
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  z-index:100;
}

.modal-overlay.show{
  display:flex;
}

.modal{
  width:100%;
  max-width:500px;
  background:white;
  border-radius:16px;
  padding:25px;
  max-height:90vh;
  overflow:auto;
}

.modal-header{
  display:flex;
  justify-content:space-between;
  margin-bottom:22px;
}

.modal-header h3{
  font-size:17px;
}

.close-btn{
  border:none;
  background:#f1f1ed;
  width:30px;
  height:30px;
  border-radius:50%;
}

.modal-footer{
  display:flex;
  justify-content:flex-end;
  gap:8px;
  margin-top:20px;
}

/* NOTIFICATIONS */

.notification-list{
  display:flex;
  flex-direction:column;
}

.notification-item{
  padding:15px 0;
  border-bottom:1px solid var(--border);
  display:flex;
  gap:12px;
}

.notification-item:last-child{
  border:none;
}

.notification-circle{
  width:32px;
  height:32px;
  border-radius:50%;
  background:var(--accent-light);
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
}

.notification-item strong{
  display:block;
  font-size:12px;
  margin-bottom:4px;
}

.notification-item p{
  color:var(--muted);
  font-size:11px;
  line-height:1.5;
}

.notification-item small{
  color:#aaa;
  font-size:9px;
}

/* EMPTY */

.empty{
  text-align:center;
  padding:35px;
  color:var(--muted);
  font-size:12px;
}

/* MOBILE */

.mobile-menu{
  display:none;
  border:none;
  background:none;
  font-size:21px;
}

@media(max-width:1000px){
  .stats{
    grid-template-columns:1fr 1fr;
  }

  .dashboard-grid,
  .attendance-box,
  .profile-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:750px){
  .sidebar{
    transform:translateX(-100%);
    transition:.25s;
  }

  .sidebar.open{
    transform:translateX(0);
  }

  .main{
    margin-left:0;
    width:100%;
  }

  .mobile-menu{
    display:block;
  }

  .topbar{
    padding:0 18px;
  }

  .content{
    padding:22px 16px;
  }

  .user-mini-info{
    display:none;
  }

  .stats{
    grid-template-columns:1fr 1fr;
  }

  .section-header{
    flex-direction:column;
    gap:12px;
  }

  .login-box{
    padding:30px 22px;
  }
}

@media(max-width:480px){
  .stats{
    grid-template-columns:1fr;
  }

  .quick-actions{
    grid-template-columns:1fr;
  }

  .attendance-actions{
    flex-direction:column;
  }

  .attendance-actions button{
    width:100%;
  }

  .time-row{
    grid-template-columns:1fr;
  }
}
</style>
</head>

<body>

<!-- LOGIN -->

<div id="loginPage" class="login-page">

  <div class="login-box">

    <div class="logo">NC</div>

    <h1>Nona Costex</h1>
    <p class="login-subtitle">Staff Portal</p>

    <form id="loginForm">

      <div class="form-group">
        <label>Staff Name / Username</label>
        <input
          type="text"
          id="loginName"
          placeholder="Enter your name"
          required
        >
      </div>

      <div class="form-group">
        <label>Staff Code</label>
        <input
          type="text"
          id="loginCode"
          placeholder="Example: NC001"
          required
        >
      </div>

      <button class="primary-btn" type="submit">
        Sign In
      </button>

    </form>

    <div class="login-note">
      Demo login: Atikah / NC001
    </div>

  </div>

</div>


<!-- APP -->

<div id="app" class="app hidden">

  <!-- SIDEBAR -->

  <aside class="sidebar" id="sidebar">

    <div class="brand">
      <div class="brand-title">Nona Costex</div>
      <div class="brand-sub">Staff Management Portal</div>
    </div>

    <div class="nav-title">Main</div>

    <button class="nav-item active" data-page="dashboard">
      <span class="nav-icon">⌂</span>
      Dashboard
    </button>

    <button class="nav-item" data-page="schedule">
      <span class="nav-icon">▦</span>
      My Schedule
    </button>

    <button class="nav-item" data-page="worklog">
      <span class="nav-icon">☷</span>
      Daily Work Log
    </button>

    <button class="nav-item" data-page="attendance">
      <span class="nav-icon">◷</span>
      Attendance
    </button>

    <button class="nav-item" data-page="leave">
      <span class="nav-icon">□</span>
      Leave
    </button>

    <div class="nav-title">Account</div>

    <button class="nav-item" data-page="notifications">
      <span class="nav-icon">♢</span>
      Notifications
    </button>

    <button class="nav-item" data-page="profile">
      <span class="nav-icon">○</span>
      My Profile
    </button>

    <div class="sidebar-bottom">
      <button class="nav-item logout-btn" id="logoutBtn">
        <span class="nav-icon">↪</span>
        Logout
      </button>
    </div>

  </aside>


  <!-- MAIN -->

  <main class="main">

    <header class="topbar">

      <div style="display:flex;align-items:center;gap:14px;">
        <button class="mobile-menu" id="mobileMenu">☰</button>
        <div class="page-title" id="pageTitle">Dashboard</div>
      </div>

      <div class="topbar-right">

        <button class="notification" id="notificationButton">
          ♢
          <span class="notification-dot"></span>
        </button>

        <div class="user-mini">

          <div class="avatar">A</div>

          <div class="user-mini-info">
            <span id="topUserName">Atikah</span>
            <small>Digital Department</small>
          </div>

        </div>

      </div>

    </header>


    <div class="content">


      <!-- DASHBOARD -->

      <section class="page active" id="dashboard">

        <div class="welcome">

          <h2>Good afternoon, Atikah</h2>

          <p>
            Here's a quick overview of your work today.
          </p>

        </div>


        <div class="stats">

          <div class="stat-card">

            <div class="stat-top">
              <span class="stat-label">Attendance</span>
              <span class="stat-icon">◷</span>
            </div>

            <div class="stat-value" id="attendanceStatus">
              Not Checked In
            </div>

            <div class="stat-desc">
              Today's attendance
            </div>

          </div>


          <div class="stat-card">

            <div class="stat-top">
              <span class="stat-label">Work Logs</span>
              <span class="stat-icon">☷</span>
            </div>

            <div class="stat-value" id="workLogCount">
              0
            </div>

            <div class="stat-desc">
              Logs submitted
            </div>

          </div>


          <div class="stat-card">

            <div class="stat-top">
              <span class="stat-label">Leave Balance</span>
              <span class="stat-icon">□</span>
            </div>

            <div class="stat-value">
              12 days
            </div>

            <div class="stat-desc">
              Remaining annual leave
            </div>

          </div>


          <div class="stat-card">

            <div class="stat-top">
              <span class="stat-label">Next Schedule</span>
              <span class="stat-icon">▦</span>
            </div>

            <div class="stat-value">
              10:00 AM
            </div>

            <div class="stat-desc">
              Content Shooting
            </div>

          </div>

        </div>


        <div class="dashboard-grid">


          <div>

            <div class="card">

              <div class="card-header">

                <div class="card-title">
                  Today's Schedule
                </div>

                <button
                  class="card-link"
                  data-go="schedule"
                >
                  View all
                </button>

              </div>

              <div class="table-wrapper">

                <table>

                  <thead>
                    <tr>
                      <th>Time</th>
                      <th>Activity</th>
                      <th>Location</th>
                      <th>Status</th>
                    </tr>
                  </thead>

                  <tbody>

                    <tr>
                      <td>10:00 AM</td>
                      <td>Content Shooting</td>
                      <td>Office</td>
                      <td>
                        <span class="badge success">
                          Today
                        </span>
                      </td>
                    </tr>

                    <tr>
                      <td>2:00 PM</td>
                      <td>Video Editing</td>
                      <td>Digital Room</td>
                      <td>
                        <span class="badge neutral">
                          Upcoming
                        </span>
                      </td>
                    </tr>

                    <tr>
                      <td>4:30 PM</td>
                      <td>Content Planning</td>
                      <td>Office</td>
                      <td>
                        <span class="badge neutral">
                          Upcoming
                        </span>
                      </td>
                    </tr>

                  </tbody>

                </table>

              </div>

            </div>


            <div class="card">

              <div class="card-header">

                <div class="card-title">
                  Recent Work Logs
                </div>

                <button
                  class="card-link"
                  data-go="worklog"
                >
                  View all
                </button>

              </div>

              <div id="dashboardWorkLogs"></div>

            </div>

          </div>


          <div>

            <div class="card">

              <div class="card-header">

                <div class="card-title">
                  Quick Actions
                </div>

              </div>

              <div class="quick-actions">

                <button class="quick-btn" data-action="checkin">
                  <span>◷</span>
                  Check In
                  <small>Record today's attendance</small>
                </button>

                <button class="quick-btn" data-action="worklog">
                  <span>☷</span>
                  Add Work Log
