                </div>

            </div>


            <div class="stats">

                <div class="stat-card">

                    <div class="stat-label">
                        Annual Leave
                    </div>

                    <div class="stat-number">
                        12
                    </div>

                    <div class="stat-small">
                        Days remaining
                    </div>

